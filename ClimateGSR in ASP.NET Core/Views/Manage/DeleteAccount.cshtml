@using ClimateGSR_in_ASP.NET_Core.Models
@model DeleteAccountViewModel
@{
    ViewBag.Title = "Delete Account";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-8 col-lg-6">
                <div class="card login-card" style="border-color: rgba(239, 68, 68, 0.3);">
                    <div style="height: 6px; background: linear-gradient(90deg, #991b1b 0%, #dc2626 50%, #f87171 100%); width: 100%;"></div>
                    <div class="card-body">
                        <div class="text-center">
                            <div class="login-brand-badge" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); color: #b91c1c; border-color: #fee2e2;" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                    <line x1="10" y1="11" x2="10" y2="17"/>
                                    <line x1="14" y1="11" x2="14" y2="17"/>
                                </svg>
                            </div>
                            <h2 class="login-title" style="color: #991b1b;" id="title">Delete Account</h2>
                            <p class="login-subtitle" style="color: #b91c1c;">Caution: This action cannot be reversed</p>
                        </div>

                        <div class="danger-warning-box">
                            <div class="d-flex align-items-start gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1">
                                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                                    <line x1="12" y1="9" x2="12" y2="13"/>
                                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                                </svg>
                                <div>
                                    <strong class="d-block mb-1">Permanent Deletion Warning</strong>
                                    <span class="small">Deleting your ClimateGSR account will permanently erase your profile, saved progress, and all associated session information. You will be signed out immediately upon confirmation.</span>
                                </div>
                            </div>
                        </div>

                        @using (Html.BeginForm("DeleteAccount", "Manage", FormMethod.Post, new { role = "form", id = "deleteAccountForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 text-center" })

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true" style="color: #b91c1c;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                    </span>
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control login-input", placeholder = "Enter your current password to confirm", autocomplete = "current-password", style = "border-color: #fca5a5;" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="form-check mb-4 p-3 rounded-3" style="background: #fef2f2; border: 1px solid #fee2e2;">
                                @Html.CheckBoxFor(m => m.ConfirmDelete, new { @class = "form-check-input", id = "confirmCheck", style = "border-color: #ef4444;" })
                                @Html.LabelFor(m => m.ConfirmDelete, new { @class = "form-check-label small fw-bold", @for = "confirmCheck", style = "color: #991b1b; cursor: pointer;" })
                                @Html.ValidationMessageFor(m => m.ConfirmDelete, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="d-grid mb-2">
                                <button type="submit" id="deleteAccountSubmitBtn" class="btn btn-dashboard-danger py-2">
                                    <span>Permanently Delete My Account</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 6h18"/>
                                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                    </svg>
                                </button>
                            </div>
                        }

                        <div class="login-register-box" style="background: #f8fafc; border-color: #cbd5e1;">
                            <p>
                                Changed your mind?
                                @Html.ActionLink("Cancel & Return to Dashboard", "Index", "Manage", null, new { @class = "login-link" })
                            </p>
                        </div>

                        <div class="login-eco-footer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    
    <script>
        $(document).ready(function () {
            $('#deleteAccountForm').on('submit', function (e) {
                if (!$('#confirmCheck').is(':checked')) {
                    $('[data-valmsg-for="ConfirmDelete"]').text('You must confirm account deletion to proceed.');
                    return false;
                }
            });
            $('#confirmCheck').on('change', function () {
                if ($(this).is(':checked')) {
                    $('[data-valmsg-for="ConfirmDelete"]').text('');
                }
            });
        });
    </script>
}
