@model ClimateGSR_in_ASP.NET_Core.Models.IndexViewModel
@{
    ViewBag.Title = "Manage Account";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="card dashboard-card">
                    <div class="login-card-top-bar"></div>
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center">
                            <div class="login-brand-badge" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <h2 class="login-title" id="title">Account Dashboard</h2>
                            <p class="login-subtitle">Manage your personal credentials and climate actions</p>

                            <div class="dashboard-user-chip">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <path d="m9 12 2 2 4-4"/>
                                </svg>
                                <span>Signed in as: <strong>@(User.Identity?.Name ?? "User")</strong></span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
                        {
                            <div class="dashboard-alert-banner">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                                <span>@ViewBag.StatusMessage</span>
                            </div>
                        }

                        <div class="dashboard-grid">
                            <!-- Button 1: Edit Account -->
                            <div class="dashboard-action-card">
                                <div class="dashboard-icon-wrapper" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                        <path d="m15 5 4 4"/>
                                    </svg>
                                </div>
                                <h3 class="dashboard-action-title">Edit Account</h3>
                                <p class="dashboard-action-desc">Update your profile email address, contact information,
                                    and security password.</p>
                                <a href="@Url.Action("EditAccount", "Manage")" class="btn btn-dashboard-action">
                                    <span>Edit Account</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M5 12h14"/>
                                        <path d="m12 5 7 7-7 7"/>
                                    </svg>
                                </a>
                            </div>

                            <!-- Button 2: Delete Account -->
                            <div class="dashboard-action-card card-danger">
                                <div class="dashboard-icon-wrapper danger-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M3 6h18"/>
                                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                        <line x1="10" y1="11" x2="10" y2="17"/>
                                        <line x1="14" y1="11" x2="14" y2="17"/>
                                    </svg>
                                </div>
                                <h3 class="dashboard-action-title">Delete Account</h3>
                                <p class="dashboard-action-desc">Permanently remove your account and delete your stored
                                    user credentials from the system.</p>
                                <a href="@Url.Action("DeleteAccount", "Manage")" class="btn btn-dashboard-danger">
                                    <span>Delete Account</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M5 12h14"/>
                                        <path d="m12 5 7 7-7 7"/>
                                    </svg>
                                </a>
                            </div>

                        </div>

                        <div class="login-eco-footer mt-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>