@using ClimateGSR_in_ASP.NET_Core.Models
@model EditAccountViewModel
@{
    ViewBag.Title = "Edit Account";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-8 col-lg-6">
                <div class="card login-card">
                    <div class="login-card-top-bar"></div>
                    <div class="card-body">
                        <div class="text-center">
                            <div class="login-brand-badge" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                    <path d="m15 5 4 4"/>
                                </svg>
                            </div>
                            <h2 class="login-title" id="title">Edit Account</h2>
                            <p class="login-subtitle">Update your personal details and security credentials</p>
                        </div>

                        @using (Html.BeginForm("EditAccount", "Manage", routeValues: null, method: FormMethod.Post, antiforgery: null, htmlAttributes: new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 text-center" })

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    @Html.LabelFor(m => m.FirstName, new { @class = "login-form-label" })
                                    <div class="login-input-group">
                                        <span class="login-input-icon" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                        </span>
                                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control login-input", placeholder = "First name", autocomplete = "given-name" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <div class="col-md-6 mb-3">
                                    @Html.LabelFor(m => m.LastName, new { @class = "login-form-label" })
                                    <div class="login-input-group">
                                        <span class="login-input-icon" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                        </span>
                                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control login-input", placeholder = "Last name", autocomplete = "family-name" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Email, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                        </svg>
                                    </span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control login-input", placeholder = "you@example.com", autocomplete = "email" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="p-3 my-3 rounded-3" style="background: #f8fbf9; border: 1px dashed #b7e4c7;">
                                <h6 class="fw-bold mb-2" style="color: #1b4332; font-size: 0.95rem;">Change Password
                                    (Optional)</h6>
                                <p class="text-muted small mb-3">Leave blank if you do not wish to update your
                                    password.</p>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.OldPassword, new { @class = "login-form-label" })
                                    <div class="login-input-group">
                                        <span class="login-input-icon" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                            </svg>
                                        </span>
                                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control login-input", placeholder = "Current password", autocomplete = "current-password" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(m => m.NewPassword, new { @class = "login-form-label" })
                                    <div class="login-input-group">
                                        <span class="login-input-icon" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="m21 2-2 2m-1.5 1.5L14 9l-1.5-1.5L11 9l-1.5-1.5L8 9 3 14a3 3 0 1 0 4 4l5-5"/>
                                            </svg>
                                        </span>
                                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control login-input", placeholder = "New password", autocomplete = "new-password" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <div class="mb-0">
                                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "login-form-label" })
                                    <div class="login-input-group">
                                        <span class="login-input-icon" aria-hidden="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path
                                                    d="m21 2-2 2m-1.5 1.5L14 9l-1.5-1.5L11 9l-1.5-1.5L8 9 3 14a3 3 0 1 0 4 4l5-5"/>
                                            </svg>
                                        </span>
                                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control login-input", placeholder = "Confirm new password", autocomplete = "new-password" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>

                            <div class="d-grid mb-2">
                                <button type="submit" class="btn btn-login-green">
                                    <span>Save Changes</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                        <polyline points="17 21 17 13 7 13 7 21"/>
                                        <polyline points="7 3 7 8 15 8"/>
                                    </svg>
                                </button>
                            </div>
                        }

                        <div class="login-register-box">
                            <p>
                                @Html.ActionLink("Back to Account Dashboard", "Index", "Manage", null, new { @class = "login-link" })
                            </p>
                        </div>

                        <div class="login-eco-footer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    
}
