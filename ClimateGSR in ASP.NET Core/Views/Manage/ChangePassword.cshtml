@using ClimateGSR_in_ASP.NET_Core.Models
@model ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-8 col-lg-5">
                <div class="card login-card">
                    <div class="login-card-top-bar"></div>
                    <div class="card-body">
                        <div class="text-center">
                            <div class="login-brand-badge" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </div>
                            <h2 class="login-title" id="title">Change Password</h2>
                            <p class="login-subtitle">Update your account security credentials</p>
                        </div>

                        @using (Html.BeginForm("ChangePassword", "Manage", routeValues: null, method: FormMethod.Post, antiforgery: null, htmlAttributes: new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 text-center" })

                            <div class="mb-3">
                                @Html.LabelFor(m => m.OldPassword, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                    </span>
                                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control login-input", placeholder = "Current password", autocomplete = "current-password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.NewPassword, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m21 2-2 2m-1.5 1.5L14 9l-1.5-1.5L11 9l-1.5-1.5L8 9 3 14a3 3 0 1 0 4 4l5-5"/>
                                        </svg>
                                    </span>
                                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control login-input", placeholder = "New password", autocomplete = "new-password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="mb-4">
                                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m21 2-2 2m-1.5 1.5L14 9l-1.5-1.5L11 9l-1.5-1.5L8 9 3 14a3 3 0 1 0 4 4l5-5"/>
                                        </svg>
                                    </span>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control login-input", placeholder = "Confirm new password", autocomplete = "new-password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="d-grid mb-2">
                                <button type="submit" class="btn btn-login-green">
                                    <span>Update Password</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12h14"/>
                                        <path d="m12 5 7 7-7 7"/>
                                    </svg>
                                </button>
                            </div>
                        }

                        <div class="login-register-box">
                            <p>
                                @Html.ActionLink("← Back to Account Dashboard", "Index", "Manage", null, new { @class = "login-link" })
                            </p>
                        </div>

                        <div class="login-eco-footer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    
}