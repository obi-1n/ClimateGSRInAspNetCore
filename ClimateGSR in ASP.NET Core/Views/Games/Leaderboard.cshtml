@model System.Collections.Generic.List<ClimateGSR_in_ASP.NET_Core.Models.LeaderboardEntryViewModel>
@{
    ViewBag.Title = "Game Leaderboard";
}

<main class="py-4" aria-labelledby="leaderboard-title">
    <h1 id="leaderboard-title">Game Leaderboard</h1>
    <p>Top 10 players ranked by their highest game score. Equal scores share a rank.</p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <caption>Players start at 0 points. Scores update when completed games are recorded.</caption>
            <thead>
                <tr>
                    <th scope="col">Rank</th>
                    <th scope="col">Player</th>
                    <th scope="col" class="text-end">High score</th>
                    <th scope="col" class="text-end">Games played</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4">No players yet. @Html.ActionLink("Create an account", "Register", "Account") to join the leaderboard.</td>
                    </tr>
                }
                @foreach (var player in Model)
                {
                    <tr class="@(player.IsCurrentPlayer ? "table-success" : null)">
                        <th scope="row">@player.Rank</th>
                        <td>
                            @player.PlayerName
                            @if (player.IsCurrentPlayer)
                            {
                                <span class="badge bg-success ms-1">You</span>
                            }
                        </td>
                        <td class="text-end">@player.HighScore</td>
                        <td class="text-end">@player.GamesPlayed</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @Html.ActionLink("Back to the map", "Index", "Home", null, new { @class = "btn btn-outline-dark" })
</main>
