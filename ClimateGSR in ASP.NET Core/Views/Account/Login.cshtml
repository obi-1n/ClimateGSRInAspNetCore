@using ClimateGSR_in_ASP.NET_Core.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
}

<main class="login-page" aria-labelledby="title">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-md-8 col-lg-5">
                <div class="card login-card">
                    <div class="login-card-top-bar"></div>
                    <div class="card-body">
                        <div class="text-center">
                            <div class="login-brand-badge" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                                </svg>
                            </div>
                            <h2 class="login-title" id="title">Welcome Back</h2>
                            <p class="login-subtitle">Sign in to your ClimateGSR portal</p>
                        </div>

                        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 text-center" })

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Email, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                        </svg>
                                    </span>
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control login-input", placeholder = "you@example.com", autocomplete = "email" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="mb-3">
                                @Html.LabelFor(m => m.Password, new { @class = "login-form-label" })
                                <div class="login-input-group">
                                    <span class="login-input-icon" aria-hidden="true">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                        </svg>
                                    </span>
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control login-input", placeholder = "Enter your password", autocomplete = "current-password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check d-flex align-items-center mb-0">
                                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input login-check-input" })
                                    @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label login-check-label" })
                                </div>
                                <div>
                                    @Html.ActionLink("Register account", "Register", null, new { @class = "login-link small" })
                                </div>
                            </div>

                            <div class="d-grid mb-2">
                                <button type="submit" class="btn btn-login-green">
                                    <span>Log in to Portal</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M5 12h14"/>
                                        <path d="m12 5 7 7-7 7"/>
                                    </svg>
                                </button>
                            </div>
                        }

                        <div class="login-register-box">
                            <p>
                                New to ClimateGSR?
                                @Html.ActionLink("Create an account", "Register", null, new { @class = "login-link" })
                            </p>
                        </div>

                        <div class="text-center">
                            @{ var externalLoginModel = new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl }; }
                            <partial name="_ExternalLoginsListPartial" model="externalLoginModel" />
                        </div>

                        <div class="login-eco-footer">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                                <path d="M2 12h20"/>
                            </svg>
                            <span>Committed to sustainability & climate action</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    
}